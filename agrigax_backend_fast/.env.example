# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real credentials.

# ── Database (MySQL) ─────────────────────────────────────
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agrigax_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
MIGRATIONS_TABLE_NAME=knex_migrations

# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS / frontend ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Set to true when frontend and backend run on different origins (SameSite=None cookies)
CROSS_ORIGIN_COOKIES=true

# ── Auth ─────────────────────────────────────────────────
# Use long random strings in any shared/production environment
ACCESS_SECRET_KEY=change_me_access_secret
REFRESH_SECRET_KEY=change_me_refresh_secret

# ── Dev conveniences ─────────────────────────────────────
# Returns the OTP in API responses (no SMS provider is integrated yet).
# Must be false in production.
EXPOSE_OTP=true
